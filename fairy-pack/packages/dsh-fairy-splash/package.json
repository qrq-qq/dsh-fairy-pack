{
  "name": "dsh-fairy-splash",
  "version": "1.0.3",
  "type": "module",
  "description": "H.D.D. boot film, holographic core hero and docked Fairy core for DeepSeek Harness Web UI",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Fairy Pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrq-qq/dsh-fairy-pack.git",
    "directory": "packages/dsh-fairy-splash"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "zzz"
  ]
}
