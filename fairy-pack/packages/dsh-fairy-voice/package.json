{
  "name": "dsh-fairy-voice",
  "version": "1.0.0",
  "type": "module",
  "description": "Fairy speech replies for DeepSeek Harness: GPT-SoVITS bridge, play button and auto-read",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bootstrap.mjs",
    "cordis.patch.yml",
    "voice.config.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "author": "Fairy Pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-account>/dsh-fairy-pack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "gpt-sovits",
    "voice"
  ]
}
